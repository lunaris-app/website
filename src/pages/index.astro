---
import "@fontsource-variable/geist";
import { Image } from "astro:assets";
import icon from "../assets/icon.png";
import library from "../assets/library.png";
import title from "../assets/title.png";

const download = "https://github.com/lunaris-app/release/releases/latest";

const features = [
  {
    name: "Manga, manhwa, manhua and light novels",
    text: "Paged or scrolling reader for comics, and a typeset reader for novels with your choice of font, size and spacing.",
  },
  {
    name: "Your library, sorted your way",
    text: "Keep titles in categories like Reading and Plan to read, pick up where you left off, and look back through your history.",
  },
  {
    name: "New chapters, waiting for you",
    text: "Lunaris checks your titles in the background and can download new chapters as they arrive.",
  },
  {
    name: "Read offline",
    text: "Download chapters to read anywhere. Each site gets one request at a time, so downloads stay gentle.",
  },
  {
    name: "Sources from extensions",
    text: "Add a repo, install the sites you read. Extensions are small scripts anyone can write and publish.",
  },
  {
    name: "Made for the desktop",
    text: "Native windows on macOS, Windows and Linux, keyboard shortcuts, a command palette and themes.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lunaris, a desktop reader for manga and light novels</title>
    <meta
      name="description"
      content="Lunaris is a free desktop reader for manga, manhwa, manhua and light novels, for macOS, Windows and Linux."
    />
    <link rel="icon" href="/icon.png" />
  </head>

  <body>
    <header class="wrap nav">
      <a class="brand" href="/">
        <Image src={icon} alt="" width={28} height={28} />
        Lunaris
      </a>

      <nav>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/lunaris-app/release">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero screentone">
        <div class="wrap">
          <h1>Every chapter,<br />one quiet window.</h1>
          <p class="lede">
            Lunaris is a desktop reader for manga, manhwa, manhua and light novels. Follow your
            titles, read online or offline, and keep it all in one library.
          </p>

          <div class="actions">
            <a class="button primary" href={download}>Download</a>
            <a class="button" href="/docs/">Read the docs</a>
          </div>

          <p class="small">Free for macOS, Windows and Linux</p>
        </div>

        <div class="wrap shot">
          <Image
            src={library}
            alt="The Lunaris library showing a manga title in the Default category"
            widths={[800, 1400, 2200]}
            sizes="(max-width: 1200px) 100vw, 1200px"
            loading="eager"
          />
        </div>
      </section>

      <section class="wrap features">
        {
          features.map((f) => (
            <div>
              <h2>{f.name}</h2>
              <p>{f.text}</p>
            </div>
          ))
        }
      </section>

      <section class="wrap split">
        <div>
          <h2 class="big">Everything about a title, at a glance</h2>
          <p>
            See the synopsis, tags and rating, start reading, or download every unread chapter in
            one click.
          </p>
          <a class="link" href="/docs/sources/">How sources work</a>
        </div>

        <div class="shot">
          <Image
            src={title}
            alt="A light novel's page in Lunaris with its cover, synopsis and chapter list"
            widths={[800, 1400, 2200]}
            sizes="(max-width: 1200px) 100vw, 800px"
          />
        </div>
      </section>

      <section class="wrap cta">
        <h2 class="big">Start reading</h2>

        <div class="actions">
          <a class="button primary" href={download}>Download Lunaris</a>
          <a class="button" href="/docs/install/">Install guide</a>
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <p>
        Lunaris doesn't host or include any content. Titles come from extensions you install, which
        read from third-party sites.
      </p>

      <p>
        <a href="https://github.com/lunaris-app/release/issues">Report an issue</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* "Moonlit ink", the app's palette (lunaris/src/style.css). */
  :root {
    color-scheme: light dark;
    --bg: light-dark(#eef0f4, #131622);
    --panel: light-dark(#f8f9fb, #1a1e2c);
    --raised: light-dark(#e1e5ec, #242a3a);
    --line: light-dark(#d5dae3, #2a3044);
    --fg: light-dark(#1a1e2b, #e6e8ef);
    --muted: light-dark(#626a7d, #8a91a6);
    --moon: light-dark(#d9a92e, #e9c964);
    --moon-ink: light-dark(#8a6510, #e9c964);
    --ink: #151826;
    --serif: "Iowan Old Style", "Palatino Linotype", Georgia, "Noto Serif", serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.6 "Geist Variable", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--moon);
    outline-offset: 2px;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .wrap {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media (min-width: 640px) {
    .wrap {
      padding: 0 32px;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 1.25rem var(--serif);
    text-decoration: none;
  }

  .nav nav {
    display: flex;
    gap: 24px;
  }

  .nav nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--fg);
  }

  /* The app's one decorative signature: a screentone dot texture. */
  .screentone {
    background-image: radial-gradient(
      color-mix(in srgb, var(--fg) 9%, transparent) 1px,
      transparent 1.2px
    );
    background-size: 6px 6px;
  }

  .hero {
    padding-top: 72px;
    border-bottom: 1px solid var(--line);
    mask-image: linear-gradient(to bottom, black 85%, transparent);
  }

  h1,
  .big {
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .big {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lede {
    max-width: 36rem;
    margin: 20px 0 0;
    font-size: 1.15rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel);
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    background: var(--raised);
  }

  .button.primary {
    background: var(--moon);
    border-color: var(--moon);
    color: var(--ink);
  }

  .button.primary:hover {
    filter: brightness(1.06);
  }

  .small {
    margin: 14px 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .shot {
    margin-top: 56px;
  }

  .shot img {
    border-radius: 12px;
  }

  .features {
    display: grid;
    gap: 0;
    margin-top: 72px;
  }

  @media (min-width: 720px) {
    .features {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 40px;
    }
  }

  .features > div {
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }

  .features h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .features p,
  .split p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .split {
    display: grid;
    gap: 40px;
    align-items: center;
    margin-top: 96px;
  }

  .split .shot {
    margin-top: 0;
  }

  @media (min-width: 960px) {
    .split {
      grid-template-columns: 1fr 2fr;
    }
  }

  .link {
    display: inline-block;
    margin-top: 16px;
    color: var(--moon-ink);
    font-weight: 500;
  }

  .cta {
    margin-top: 120px;
    padding-top: 56px;
    border-top: 1px solid var(--line);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 96px;
    padding-top: 24px;
    padding-bottom: 40px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer p {
    margin: 0;
    max-width: 36rem;
  }
</style>
