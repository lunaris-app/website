{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunaris-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Serve Starlight's 404.html for unknown paths
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`; assets stay configured at the top level
  "previews": {}
}
